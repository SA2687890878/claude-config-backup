# 统一行尾（Windows 生态 CRLF；Git 存储 LF，checkout 时转 CRLF）
* text=auto
*.md text eol=crlf
*.json text eol=crlf
*.js text eol=crlf
*.cjs text eol=crlf
*.mjs text eol=crlf
*.ps1 text eol=crlf
*.yaml text eol=crlf
*.yml text eol=crlf
*.psm1 text eol=crlf
*.sql text eol=crlf
# 二进制/不可转
*.png binary
*.jpg binary
*.ico binary
*.pdf binary