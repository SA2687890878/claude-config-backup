{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./.github/hooks/copilot-hook-bridge.js SessionStart",
        "timeout": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node ./.github/hooks/copilot-hook-bridge.js UserPromptSubmit",
        "timeout": 20
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node ./.github/hooks/copilot-hook-bridge.js PreToolUse",
        "timeout": 90
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node ./.github/hooks/copilot-hook-bridge.js PostToolUse",
        "timeout": 120
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./.github/hooks/copilot-hook-bridge.js Stop",
        "timeout": 240
      }
    ]
  }
}
