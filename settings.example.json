{
  "_comment": "settings.json 示例文件。复制为 settings.json 后填入你的 API Token。",
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "你的 Token",
    "ANTHROPIC_BASE_URL": "https://你的 API 地址",
    "ANTHROPIC_MODEL": "你的模型"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(dotnet *)",
      "Bash(rtk *)",
      "Bash(codegraph *)",
      "Bash(npm *)",
      "Bash(node *)",
      "mcp__codegraph__*",
      "mcp__context-mode__*",
      "mcp__context7__*",
      "mcp__memory__*",
      "mcp__sequential-thinking__*"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git push origin main*)",
      "Bash(git push origin develop*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node C:/Users/你的用户名/.claude/hooks/secret-guard.js", "timeout": 10 },
          { "type": "command", "command": "node C:/Users/你的用户名/.claude/hooks/write-guard.js", "timeout": 10 },
          { "type": "command", "command": "node C:/Users/你的用户名/.claude/hooks/impact-guard.js", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node C:/Users/你的用户名/.claude/hooks/secret-guard.js", "timeout": 10 },
          { "type": "command", "command": "node C:/Users/你的用户名/.claude/hooks/rtk-wrapper.js", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node C:/Users/你的用户名/.claude/hooks/cs-guard.js", "timeout": 25 },
          { "type": "command", "command": "node C:/Users/你的用户名/.claude/hooks/quality-guard.js", "timeout": 15 },
          { "type": "command", "command": "node C:/Users/你的用户名/.claude/hooks/build-guard.js", "timeout": 15 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node C:/Users/你的用户名/.claude/hooks/caveman-activate.js", "timeout": 15 }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context-mode@context-mode": true,
    "context7@local": true,
    "exa-search@local": true,
    "github@local": true,
    "memory@local": true,
    "sequential-thinking@local": true,
    "caveman@caveman": true
  },
  "model": "opus"
}
